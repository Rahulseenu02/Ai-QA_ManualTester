# Copy to .qa/config.env (gitignored). Paste secrets yourself in the editor — never in chat.

# Jira Cloud
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
JIRA_PROJECT=BWS
# Custom field that holds acceptance criteria (leave empty if AC are in the description)
JIRA_AC_FIELD=
# Issue type used for access requests
JIRA_ACCESS_ISSUETYPE=Task

# Zephyr Scale Cloud
ZEPHYR_TOKEN=
ZEPHYR_PROJECT_KEY=BWS
# EU: https://eu.api.zephyrscale.smartbear.com/v2
ZEPHYR_BASE_URL=https://api.zephyrscale.smartbear.com/v2

# Workflow status names (quoted, comma-separated, JQL style)
QA_RETEST_STATUSES='"Ready for Retest","Resolved"'
QA_READY_STATUSES='"Ready for QA","In QA"'
QA_REOPEN_STATUS=Reopened
QA_BLOCKER_JQL='(Flagged = Impediment) AND (assignee = currentUser() OR reporter = currentUser()) AND statusCategory != Done'
QA_AUTOMATION_LABELS=automation,auto-failure
