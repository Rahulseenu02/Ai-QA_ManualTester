# Copy to .qa/platform.env (gitignored). No secrets here.

APP_NAME=My App
APP_URL=https://staging.example.com
# Hand-runs refuse these hosts
PROD_HOSTS=app.example.com,www.example.com

# Version source (first that answers wins). Never from memory.
APP_VERSION_URL=https://staging.example.com/api/version
APP_VERSION_CMD=

# Automation suite
AUTOMATION_REPO=../playwrightPOM
AUTOMATION_RUN='npx playwright test --project=chromium'
